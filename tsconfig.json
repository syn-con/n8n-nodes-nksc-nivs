{
	
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "CommonJS",
		"lib": ["ES2022"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"incremental": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["index.ts", "credentials/**/*.ts", "nodes/**/*.ts"],
	"exclude": ["**/*.test.ts"]
}
